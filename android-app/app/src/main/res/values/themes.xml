<resources>
    <!-- MkulimaFeeds High-End Design System -->
    <style name="Theme.MkulimaFeeds" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">#0052FF</item>
        <item name="colorSecondary">#00E676</item>
        <item name="android:windowBackground">#F8F9FD</item>

        <!-- Standardized Typography (Sprint 9 Refinement) -->
        <item name="textAppearanceHeadlineMedium">@style/MkulimaHeadline</item>
        <item name="textAppearanceBodyLarge">@style/MkulimaBody</item>

        <!-- Component Rounding (Requirement: Rounded Components) -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Mkulima.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Mkulima.Medium</item>
    </style>

    <style name="Base.Theme.MkulimaFeeds" parent="Theme.MkulimaFeeds" />

    <!-- Professional Typography -->
    <style name="MkulimaHeadline">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1A1C1E</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MkulimaBody">
        <item name="android:textColor">#6C7278</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Global Component Rounding -->
    <style name="ShapeAppearance.Mkulima.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Mkulima.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="styles.MkulimaFeeds" parent="Base.Theme.MkulimaFeeds" />
</resources>