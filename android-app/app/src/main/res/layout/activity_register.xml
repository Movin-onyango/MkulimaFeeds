<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/register_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">
            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="#04261B"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/app_name"
                android:textColor="#04261B"
                android:textStyle="bold"
                android:textSize="22sp"/>
        </LinearLayout>

        <!-- ============================================================
             STEP 1: REGISTRATION FORM
             ============================================================ -->
        <LinearLayout
            android:id="@+id/layoutFormStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Create an Account"
                android:textColor="#04261B"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Register with your email or phone number."
                android:textColor="#757575"
                android:gravity="center"
                android:textSize="13sp"/>

            <!-- Identifier toggle: Email / Phone -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabEmail"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Email"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="#04261B"/>

                    <TextView
                        android:id="@+id/tabPhone"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Phone"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:background="#FFFFFF"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Full name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Full Name"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#04261B"/>
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/rounded_edittext"
                android:hint="Enter your full name"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:inputType="textPersonName"
                android:maxLines="1"/>

            <!-- Email input (visible when Email tab selected) -->
            <LinearLayout
                android:id="@+id/layoutEmailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Email Address"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#04261B"/>
                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/rounded_edittext"
                    android:hint="name@example.com"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"/>
            </LinearLayout>

            <!-- Phone input (visible when Phone tab selected) -->
            <LinearLayout
                android:id="@+id/layoutPhoneInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Phone Number"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#04261B"/>
                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/rounded_edittext"
                    android:hint="0712345678"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:inputType="phone"
                    android:maxLines="1"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kenyan numbers only (07XX, 01XX, or +254)"
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"/>
            </LinearLayout>

            <!-- Password field with visibility toggle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Password"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#04261B"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#04261B"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#757575"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="At least 8 characters"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="14sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm Password field with visibility toggle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Confirm Password"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#04261B"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#04261B"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#757575"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Re-enter your password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="14sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Terms checkbox -->
            <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="I agree to the Terms of Service and Privacy Policy"
                android:textSize="12sp"
                android:textColor="#757575"/>

            <!-- Continue button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:text="Continue"
                android:textAllCaps="false"
                android:backgroundTint="#04261B"
                app:cornerRadius="30dp"/>

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Already have an account? Login here"
                android:textColor="#757575"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- ============================================================
             STEP 2: OTP VERIFICATION
             ============================================================ -->
        <LinearLayout
            android:id="@+id/layoutOtpStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Verify Your Account"
                android:textColor="#04261B"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOtpSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enter the 6-digit code we sent to your email."
                android:textColor="#757575"
                android:textSize="13sp"
                android:gravity="center"/>

            <!-- OTP input -->
            <EditText
                android:id="@+id/etOtp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/rounded_edittext"
                android:hint="123456"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="6"
                android:textSize="24sp"
                android:letterSpacing="0.5"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <TextView
                android:id="@+id/tvResendTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Resend code in 60s"
                android:gravity="center"
                android:textColor="#9CA3AF"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvResendCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Resend code"
                android:gravity="center"
                android:textColor="#04261B"
                android:textStyle="bold"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="Verify &amp; Continue"
                android:textAllCaps="false"
                android:backgroundTint="#04261B"
                app:cornerRadius="30dp"/>

            <TextView
                android:id="@+id/tvBackToForm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="← Use a different email/phone"
                android:textColor="#757575"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>