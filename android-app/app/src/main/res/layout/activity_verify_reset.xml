<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/verifyResetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Top Logo -->
        <LinearLayout
            android:id="@+id/logoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@color/brand_dark_green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                android:textColor="@color/brand_dark_green"
                android:textStyle="bold"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="Enter Codes"
            android:textColor="@color/brand_dark_green"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/logoLayout" />

        <TextView
            android:id="@+id/subTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textColor="#757575"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/titleText" />

        <!-- Email code input -->
        <LinearLayout
            android:id="@+id/layoutEmailCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/subTitleText">

            <TextView
                android:id="@+id/labelEmailCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EMAIL CODE"
                android:textColor="#424242"
                android:textStyle="bold"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etEmailCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_edittext"
                android:hint="6-digit code"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="number"
                android:maxLength="6"
                android:letterSpacing="0.2"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Phone code input -->
        <LinearLayout
            android:id="@+id/layoutPhoneCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layoutEmailCode">

            <TextView
                android:id="@+id/labelPhoneCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PHONE CODE"
                android:textColor="#424242"
                android:textStyle="bold"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etPhoneCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_edittext"
                android:hint="6-digit code"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="number"
                android:maxLength="6"
                android:letterSpacing="0.2"
                android:textSize="18sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyCodes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="Verify Codes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#04261B"
            app:cornerRadius="30dp"
            app:layout_constraintTop_toBottomOf="@id/layoutPhoneCode" />

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/btnVerifyCodes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Start over"
                android:textColor="#757575"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>