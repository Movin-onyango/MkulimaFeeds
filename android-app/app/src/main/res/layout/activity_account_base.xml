<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accountBaseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFB">

    <!-- Top bar -->
    <RelativeLayout
        android:id="@+id/accountTopBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvAccountTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="ACCOUNT"
            android:textColor="@color/brand_dark_green"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </RelativeLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/accountScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/accountTopBar"
        app:layout_constraintBottom_toTopOf="@id/accountBottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/accountContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- HERO SLOT (role-specific) -->
            <FrameLayout
                android:id="@+id/accountHeroSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- STATS STRIP SLOT (role-specific) -->
            <LinearLayout
                android:id="@+id/accountStatsSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal" />

            <!-- ACTIVITY SECTION (role-specific) -->
            <FrameLayout
                android:id="@+id/accountActivitySlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- EXTRA SECTION SLOT (role-specific, nullable) -->
            <FrameLayout
                android:id="@+id/accountExtraSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- SHARED SECTIONS (rendered by base) -->
            <FrameLayout
                android:id="@+id/accountSecuritySlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:id="@+id/accountPreferencesSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:id="@+id/accountSupportSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- DANGER SECTION (rendered by base) -->
            <FrameLayout
                android:id="@+id/accountDangerSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom nav slot (filled dynamically by base activity) -->
    <FrameLayout
        android:id="@+id/accountBottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/accountLoadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CCFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/accountTopBar"
        app:layout_constraintBottom_toTopOf="@id/accountBottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_dark_green" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>