<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/delivery_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FBFF">

    <!-- 1. Header Toolbar -->
    <RelativeLayout
        android:id="@+id/deliveryHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="20dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#04261B"
            android:contentDescription="Back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="MkulimaFeeds"
            android:textStyle="bold"
            android:textColor="#04261B"
            android:textSize="18sp"/>
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#04261B"
            android:contentDescription="Profile" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/deliveryHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomActionLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title and Step Indicator -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Details"
                    android:textColor="#04261B"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignBottom="@id/tvTitle"
                    android:text="STEP 1 OF 2"
                    android:textSize="10sp"
                    android:textColor="#757575"
                    android:letterSpacing="0.1"/>
                <View
                    android:layout_width="160dp"
                    android:layout_height="3dp"
                    android:layout_below="@id/tvTitle"
                    android:layout_marginTop="8dp"
                    android:background="#04261B"/>
            </RelativeLayout>

            <!-- Card 1: Delivery Date -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="8dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PREFERRED DELIVERY DATE" android:textSize="10sp" android:textStyle="bold" android:textColor="#424242"/>
                    <EditText
                        android:id="@+id/etDeliveryDate"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/rounded_edittext"
                        android:hint="Select date"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:importantForAutofill="no"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Telephone Number -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONTACT NUMBER" android:textSize="10sp" android:textStyle="bold" android:textColor="#424242"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:layout_width="80dp" android:layout_height="match_parent" android:background="@drawable/rounded_edittext" android:gravity="center" android:text="+254 ▾" android:textSize="14sp"/>
                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/rounded_edittext"
                            android:hint="7XX XXX XXX"
                            android:paddingHorizontal="12dp"
                            android:inputType="phone"
                            android:importantForAutofill="no"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Location -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DELIVERY ADDRESS" android:textSize="10sp" android:textStyle="bold" android:textColor="#424242"/>
                    <EditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/rounded_edittext"
                        android:hint="Street name, Building, or Landmark"
                        android:drawableStart="@android:drawable/ic_menu_mylocation"
                        android:drawablePadding="8dp"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:importantForAutofill="no"
                        android:inputType="textPostalAddress"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCurrentLocation"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="Use Current Location"
                        android:textAllCaps="false"
                        android:textColor="#04261B"
                        app:icon="@android:drawable/ic_menu_mylocation"
                        app:iconTint="#04261B"
                        android:textSize="12sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Logistics Summary -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#F1F3F5"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Order Summary" android:textStyle="bold" android:textColor="#04261B" android:textSize="18sp"/>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Items Total" android:textColor="#757575"/>
                        <TextView
                            android:id="@+id/tvItemsTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="KES 14,200.00"
                            android:textColor="#1A1A1A"
                            android:textStyle="bold"/>
                    </RelativeLayout>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delivery Fee" android:textColor="#757575"/>
                        <TextView
                            android:id="@+id/tvDeliveryFee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="KES 0.00"
                            android:textColor="#2E7D32"
                            android:textStyle="bold"/>
                    </RelativeLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="#E0E0E0"/>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amount to Pay" android:textStyle="bold" android:textColor="#04261B" android:textSize="18sp"/>
                        <TextView
                            android:id="@+id/tvGrandTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="KES 14,200.00"
                            android:textStyle="bold"
                            android:textColor="#1B3A31"
                            android:textSize="18sp"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer Button -->
    <LinearLayout
        android:id="@+id/bottomActionLayout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="20dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue to Payment  →"
            android:textAllCaps="false"
            android:backgroundTint="#2E5225"
            app:cornerRadius="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>