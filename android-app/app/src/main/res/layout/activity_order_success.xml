<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/success_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FBFF">

    <!-- 1. Header Toolbar -->
    <RelativeLayout
        android:id="@+id/successHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="20dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_directions"
            app:tint="#04261B"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="MkulimaFeeds"
            android:textStyle="bold"
            android:textColor="#04261B"
            android:textSize="18sp"/>
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#04261B"/>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/successHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Success Icon -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#2E5225"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="#FFFFFF"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Order Confirmed"
                android:textColor="#04261B"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your agricultural supply order has been received and is currently being processed."
                android:textColor="#757575"
                android:gravity="center"
                android:textSize="13sp"/>

            <!-- Reference Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="REFERENCE NUMBER" android:textSize="10sp" android:textColor="#757575" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="#MF-99284-AX" android:textSize="18sp" android:textStyle="bold" android:textColor="#1A1A1A" android:typeface="monospace"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#F0F0F0"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="EXPECTED DELIVERY\nOct 24, 2024" android:textSize="14sp" android:textStyle="bold" android:textColor="#1A1A1A"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@android:drawable/btn_default" android:background="#04261B"/>
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#88000000"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:padding="16dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#2E5225" android:paddingHorizontal="8dp" android:text="📦 IN PREPARATION" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your bulk feed is being loaded." android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Back Home Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackHome"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="Back to Home"
                android:textAllCaps="false"
                android:backgroundTint="#2E5225"
                app:icon="@android:drawable/ic_menu_today"
                app:cornerRadius="8dp"/>

            <!-- View Orders Button -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btnViewOrders"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:text="View My Orders"
                android:textAllCaps="false"
                android:textColor="#04261B"
                app:strokeColor="#E0E0E0"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconTint="#04261B"
                app:cornerRadius="8dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>