<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvMetricLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Metric Name"
            android:textColor="#1A1C1E"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMetricValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="0%"
            android:textColor="@color/brand_blue"
            android:textStyle="bold" />
    </RelativeLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="0"
        app:indicatorColor="@color/brand_blue"
        app:trackColor="#E8EFFF"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvMetricGrowthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Growth"
            android:textColor="#757575"
            android:textSize="10sp"/>

        <TextView
            android:id="@+id/tvMetricGrowth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="0.0%"
            android:textSize="10sp"
            android:textStyle="bold"/>

    </RelativeLayout>
</LinearLayout>