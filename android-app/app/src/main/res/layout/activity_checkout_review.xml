<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/review_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FBFF">

    <!-- 1. Toolbar -->
    <RelativeLayout
        android:id="@+id/reviewHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#04261B"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Order Review"
            android:textStyle="bold"
            android:textColor="#04261B"
            android:textSize="18sp"/>
    </RelativeLayout>

    <!-- 2. Step Indicator -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stepIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/reviewHeader">

        <TextView
            android:id="@+id/tvStepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP 2 OF 2"
            android:textSize="11sp"
            android:textColor="#757575"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvReviewLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINAL REVIEW"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#424242"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/progressBar"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:background="#04261B"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvStepLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/stepIndicator"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Delivery Details Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🚚 Delivery Details" android:textStyle="bold" android:textColor="#04261B"/>
                        <TextView
                            android:id="@+id/btnEditDetails"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true" android:text="EDIT" android:textColor="#757575" android:textSize="11sp" android:textStyle="bold"
                            android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground"/>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvSummaryPhone"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="CONTACT\n+254 7XX XXX XXX" android:textSize="11sp" android:textColor="#757575" android:lineSpacingExtra="4dp"/>
                    <TextView
                        android:id="@+id/tvSummaryAddress"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="ADDRESS\nGreenhouse Office Park, Ngong Road" android:textSize="11sp" android:textColor="#757575" android:lineSpacingExtra="4dp"/>
                    <TextView
                        android:id="@+id/tvSummaryDate"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="DATE\nPick a date" android:textSize="11sp" android:textColor="#757575" android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order Summary and Buttons -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#04261B"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Order Summary" android:textStyle="bold" android:textSize="16sp"/>

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grand Total" android:textStyle="bold" android:textSize="18sp"/>
                        <TextView
                            android:id="@+id/tvGrandTotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true"
                            android:text="KES 0.00" android:textStyle="bold" android:textSize="18sp" android:textColor="#04261B"/>
                    </RelativeLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPayNow"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:text="Pay Now"
                        android:textAllCaps="false"
                        android:backgroundTint="#2E5225"
                        app:icon="@android:drawable/ic_menu_send"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPayLater"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:text="Pay Later"
                        android:textAllCaps="false"
                        android:textColor="#1A1A1A"
                        android:backgroundTint="#E9ECEF"
                        app:icon="@android:drawable/ic_menu_agenda"
                        app:iconTint="#1A1A1A"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MovoGuard Badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#EBF3FF"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_lock_idle_lock" android:contentDescription="Secured" app:tint="#2B579A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                        android:text="MovoGuard™ Transaction\nYour order is protected by our reliability guarantee." android:textSize="11sp" android:textColor="#2B579A"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>