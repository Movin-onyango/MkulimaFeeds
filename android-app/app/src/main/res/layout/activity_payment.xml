<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/payment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/secureHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_lock_idle_lock"
            app:tint="#0D47A1"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Secure Checkout"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:textSize="18sp"/>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/secureHeader"
        app:layout_constraintBottom_toTopOf="@id/btnPayNow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="TOTAL AMOUNT DUE"
                android:textSize="12sp"
                android:textColor="#9E9E9E"/>

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="KES 0.00"
                android:textColor="#04261B"
                android:textSize="32sp"
                android:textStyle="bold"/>

            <!-- M-Pesa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
                    <View android:id="@+id/iconMpesa" android:layout_width="48dp" android:layout_height="48dp" android:background="#00E676" android:alpha="0.2"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconMpesa" android:layout_marginStart="16dp" android:text="M-Pesa" android:textStyle="bold" android:layout_centerVertical="true"/>
                    <RadioButton android:id="@+id/radioMpesa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Airtel Money -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
                    <View android:id="@+id/iconAirtel" android:layout_width="48dp" android:layout_height="48dp" android:background="#FF1744" android:alpha="0.1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconAirtel" android:layout_marginStart="16dp" android:text="Airtel Money" android:textStyle="bold" android:layout_centerVertical="true"/>
                    <RadioButton android:id="@+id/radioAirtel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Telkom (Telecom) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
                    <View android:id="@+id/iconTelkom" android:layout_width="48dp" android:layout_height="48dp" android:background="#2979FF" android:alpha="0.1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconTelkom" android:layout_marginStart="16dp" android:text="Telkom T-Kash" android:textStyle="bold" android:layout_centerVertical="true"/>
                    <RadioButton android:id="@+id/radioTelkom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bank Transfer -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
                    <View android:id="@+id/iconBank" android:layout_width="48dp" android:layout_height="48dp" android:background="#455A64" android:alpha="0.1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconBank" android:layout_marginStart="16dp" android:text="Bank Transfer (Equity/KCB)" android:textStyle="bold" android:layout_centerVertical="true"/>
                    <RadioButton android:id="@+id/radioBank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPayNow"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        android:text="Pay Now"
        android:textAllCaps="false"
        android:backgroundTint="#04261B"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>