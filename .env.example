# ============================================================
# MkulimaFeeds — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# ============================================================

# --- Database ---
DB_NAME=mkulimafeeds_db
DB_USER=mkulimafeeds_app
DB_PASSWORD=change_me_to_a_strong_password
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string

# --- Email (optional) ---
# Get a free key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=MkulimaFeeds <onboarding@resend.dev>

# --- SMS (optional) ---
# Get a sandbox key at https://africastalking.com
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=